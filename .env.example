# Copy to `.env` (Prisma + seed) and `.env.local` (Auth secret), then fill in.

# --- Neon Postgres (.env) ---
# Pooled connection string (host contains "-pooler") used by the running app:
DATABASE_URL=
# Direct/unpooled connection string, used by `prisma migrate`:
DATABASE_URL_UNPOOLED=

# Seed admin credentials (prisma/seed.ts):
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Auth.js (.env.local) ---
# Generate with: npx auth secret
AUTH_SECRET=
