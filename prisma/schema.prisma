generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon: pooled connection string for the running app...
  url       = env("DATABASE_URL")
  // ...and the direct (unpooled) connection for `prisma migrate`.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  admin
  client
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // bcrypt hash used by the Credentials provider
  role          Role      @default(client)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Event cards shown on /[locale]/events, managed from /admin/events.
// One row per event (single-language — the owner writes each card in one
// language). `image` holds a public path (e.g. /events/x.jpg) or an uploaded
// data URL. Read via lib/events.ts, written via lib/event-actions.ts.
model Event {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String // multi-line; blank lines separate paragraphs
  image       String? // public path or data: URL (uploaded, downscaled)
  published   Boolean  @default(true)
  sortOrder   Int      @default(0) // lower shows first
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

// Admin-editable site content: one row per (content key, locale).
// e.g. key "about.body" with locales de/en/it. Read via lib/content.ts.
model ContentBlock {
  id        String   @id @default(cuid())
  key       String
  locale    String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
  @@map("content_blocks")
}
